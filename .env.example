# Private ICS feed URL (e.g. Google Calendar's "Secret address in iCal format")
ICS_URL=

# Both sender and recipient for the daily brief
EMAIL_FROM=sai150306@gmail.com
EMAIL_TO=sai150306@gmail.com

# Gmail API OAuth credentials (Google Cloud Console -> OAuth client, "Desktop app")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Obtained once via: npm run get-refresh-token
GMAIL_REFRESH_TOKEN=

# Local hour (America/Chicago) the brief should send at. Default 7.
SEND_HOUR_LOCAL=7

# Optional: shared secret to protect /api/daily-brief from unauthenticated
# triggers. If set, Vercel Cron requests (which carry this automatically)
# and manual calls with ?secret=... are accepted; everything else is 401'd.
CRON_SECRET=
