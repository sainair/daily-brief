# Private ICS feed URL (e.g. Google Calendar's "Secret address in iCal format")
ICS_URL=

# Resend API key (starts with "re_") from https://resend.com/api-keys
RESEND_KEY=

# Sender address. Resend only accepts a domain you have verified with them,
# with one exception: onboarding@resend.dev works with no setup but can ONLY
# deliver to the email address on your own Resend account. Since this tool
# only ever mails you, that exception is all you need — a friendly name is
# optional, e.g. EMAIL_FROM="Briefer <onboarding@resend.dev>".
# To send anywhere else, verify a domain at https://resend.com/domains first.
EMAIL_FROM=onboarding@resend.dev

# Recipient. While sending from onboarding@resend.dev this MUST be the email
# address on your Resend account, or the send is rejected with a 403.
EMAIL_TO=you@example.com

# Local hour (America/Chicago) the brief should send at. Default 7.
SEND_HOUR_LOCAL=7

# Optional: shared secret to protect /api/daily-brief from unauthenticated
# triggers. If set, Vercel Cron requests (which carry this automatically)
# and manual calls with ?secret=... are accepted; everything else is 401'd.
CRON_SECRET=
